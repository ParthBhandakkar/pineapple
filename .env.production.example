DATABASE_URL="postgresql://agentsim:change-me@postgres:5432/agentsim?schema=public"
POSTGRES_DB="agentsim"
POSTGRES_USER="agentsim"
POSTGRES_PASSWORD="change-me"
REDIS_URL="redis://redis:6379"

SESSION_SECRET="replace-with-a-long-random-secret"
COOKIE_SECURE="true"

OPENROUTER_API_KEY=""
# LLM HTTP timeout (ms) for OpenRouter + OpenCode client calls. Default in code is 300000 when unset.
MODEL_REQUEST_TIMEOUT_MS="300000"
OPENROUTER_SITE_URL="https://app.yourdomain.com"
OPENROUTER_APP_NAME="PineApple"
# Optional: override OpenRouter API endpoint
#OPENROUTER_BASE_URL=""
# Max retry attempts for OpenCode upstream provider calls (default: 8)
#OPENROUTER_MAX_ATTEMPTS=8

OPENCODE_SERVER_URL="http://opencode:4096"
OPENCODE_SERVER_USERNAME="opencode"
OPENCODE_SERVER_PASSWORD=""

# Default billing model code (must match a code in models.ts)
#DEFAULT_BILLING_MODEL="deepseek-v3-2"

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
#RAZORPAY_API_BASE_URL=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://app.yourdomain.com/api/auth/google/callback"

SEED_ADMIN_EMAIL="admin@agentsim.local"
SEED_ADMIN_PASSWORD="change-me-strong-password"
SEED_USER_EMAIL="demo@agentsim.local"
SEED_USER_PASSWORD="change-me-strong-password"

# Private test / staging only. MUST be false in real production.
TESTING_UNLIMITED="false"

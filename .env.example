DATABASE_URL="postgresql://agentsim:change-me@127.0.0.1:5432/agentsim?schema=public"
REDIS_URL="redis://127.0.0.1:6379"
SESSION_SECRET="replace-with-a-long-random-secret"
COOKIE_SECURE="false"

# OpenRouter
OPENROUTER_API_KEY=""
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_APP_NAME="PineApple"
# Optional: override OpenRouter API endpoint (default: https://openrouter.ai/api/v1/chat/completions)
#OPENROUTER_BASE_URL=""
# Optional: fallback model when retries are exhausted (default: openrouter/auto)
#OPENROUTER_FALLBACK_MODEL="openrouter/auto"
# Max retry attempts for OpenRouter calls (default: 8)
#OPENROUTER_MAX_ATTEMPTS=8
# Max wait for OpenRouter / OpenCode model calls (ms). Default 300000 (5 min).
#MODEL_REQUEST_TIMEOUT_MS=300000

# Optional OpenCode headless server integration
OPENCODE_SERVER_URL="http://127.0.0.1:4096"
OPENCODE_SERVER_USERNAME="opencode"
OPENCODE_SERVER_PASSWORD=""
# When true, fail tasks instead of falling back to OpenRouter when OpenCode is unavailable
#FORCE_OPENCODE_ONLY="false"

# Default billing model code (must match a code in models.ts)
#DEFAULT_BILLING_MODEL="deepseek-v3-2"

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
# Optional: override Razorpay API base URL for sandbox (default: https://api.razorpay.com)
#RAZORPAY_API_BASE_URL=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Private test deployments only: true = no daily task cap, no token debits/balance gates, all models, relaxed deploy limits
TESTING_UNLIMITED="false"

# Set to "true" to show demo credentials on the login page
#NEXT_PUBLIC_DEMO_MODE="false"

# Local auth seed credentials
SEED_ADMIN_EMAIL="admin@agentsim.local"
SEED_ADMIN_PASSWORD="admin123"
SEED_USER_EMAIL="demo@agentsim.local"
SEED_USER_PASSWORD="demo123"

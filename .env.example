DATABASE_URL="postgresql://agentsim:change-me@127.0.0.1:5432/agentsim?schema=public"
REDIS_URL="redis://127.0.0.1:6379"
SESSION_SECRET="replace-with-a-long-random-secret"
COOKIE_SECURE="false"

# OpenRouter
OPENROUTER_API_KEY=""
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_APP_NAME="PineApple"
# Optional: override OpenRouter API endpoint (default: https://openrouter.ai/api/v1/chat/completions)
#OPENROUTER_BASE_URL=""
# OpenCode orchestration
# For all chat/task responses in this deployment, OpenCode is the runtime used by default.
# MODEL_REQUEST_TIMEOUT_MS controls both OpenCode call timeout and OpenCode upstream fetch timeout.
#MODEL_REQUEST_TIMEOUT_MS=300000

# Optional OpenCode headless server integration
OPENCODE_SERVER_URL="http://127.0.0.1:4096"
OPENCODE_SERVER_USERNAME="opencode"
OPENCODE_SERVER_PASSWORD=""
# Optional OpenCode model selectors used by the OpenCode server/provider layer.
# If blank, values from deploy/opencode/opencode.json or server defaults apply.
#OPENCODE_MODEL="deepseek/deepseek-coder"
#OPENCODE_SMALL_MODEL="qwen/qwen3-coder"

# OpenRouter key is still required only when the OpenCode backend routes through
# OpenRouter providers.
OPENROUTER_API_KEY=""

# Default billing model code (must match a code in models.ts)
#DEFAULT_BILLING_MODEL="deepseek-v3-2"

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
# Optional: override Razorpay API base URL for sandbox (default: https://api.razorpay.com)
#RAZORPAY_API_BASE_URL=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Private test deployments only: true = no daily task cap, no token debits/balance gates, all models, relaxed deploy limits
TESTING_UNLIMITED="false"

# Set to "true" to show demo credentials on the login page
#NEXT_PUBLIC_DEMO_MODE="false"

# Local auth seed credentials
SEED_ADMIN_EMAIL="admin@agentsim.local"
SEED_ADMIN_PASSWORD="admin123"
SEED_USER_EMAIL="demo@agentsim.local"
SEED_USER_PASSWORD="demo123"

#!/usr/bin/expect -f
# Usage: DEPLOY_SSH_PASSWORD=... pw-scp.expect <src> <dest>
set timeout -1
if {![info exists env(DEPLOY_SSH_PASSWORD)]} {
  puts stderr "DEPLOY_SSH_PASSWORD is not set"
  exit 2
}
set pw $env(DEPLOY_SSH_PASSWORD)
if {[llength $argv] < 2} {
  puts stderr "usage: pw-scp.expect src dest"
  exit 2
}
set src [lindex $argv 0]
set dest [lindex $argv 1]
log_user 1
spawn scp -o StrictHostKeyChecking=no $src $dest
expect {
  -re "(?i)yes/no" { send "yes\r"; exp_continue }
  -re "(?i)password:" { send "$pw\r"; exp_continue }
  eof
}
catch wait result
exit [lindex $result 3]
